def count_greater_than_previous(arr):
    count = 0
    for i in range(1, len(arr)):  
      if arr[i] > arr[i - 1]:  
            count += 1
    return count

if __name__ == "__main__":
    n = int(input())
    array = list(map(int, input().split()))    
    print(count_greater_than_previous(array))
