def find_min(a, b, c, d):
    return min(a, b, c, d)

if __name__ == "__main__":
    numbers = list(map(int, input("Введите четыре числа через пробел: ").split()))
    
    if len(numbers) == 4:
        print(find_min(numbers[0], numbers[1], numbers[2], numbers[3]))
    else:
        print("Ошибка: необходимо ввести ровно четыре числа.")
